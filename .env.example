# Copia este archivo a .env y completá los valores. NUNCA subas .env al repo.

# --- LLM en la nube (opcional, solo cuando hay internet) ---
ANTHROPIC_API_KEY=

# --- Fuente de datos: simulator | can (NMEA 2000 por SocketCAN, RH-02) ---
MAREX_DATA_SOURCE=simulator

# --- Puerto serial del Maretron USB100 (cuando MAREX_DATA_SOURCE=serial) ---
# Windows: COM3 | Linux/Jetson: /dev/ttyUSB0
MAREX_SERIAL_PORT=

# --- Interfaz SocketCAN (cuando MAREX_DATA_SOURCE=can) ---
MAREX_CAN_CHANNEL=can0

# --- Servidor API ---
MAREX_API_HOST=0.0.0.0
MAREX_API_PORT=8000

# --- IA local (Ollama) ---
# Modelo a usar; debe estar instalado en Ollama (ollama list).
MAREX_LLM_MODEL=llama3.2:3b
# Host de Ollama (default local).
MAREX_OLLAMA_HOST=http://localhost:11434
